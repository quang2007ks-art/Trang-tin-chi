            if (u === STUDENT_ACCOUNT.username && p === STUDENT_ACCOUNT.password) {
                isAuthenticated = true;
                loginErrorMsg.style.display = 'none';
                portalUserLabel.innerHTML = `${STUDENT_ACCOUNT.fullName}<br>${STUDENT_ACCOUNT.classCode}`;
